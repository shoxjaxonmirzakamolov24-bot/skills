# ====================================================================
# SkillSwap muhit o'zgaruvchilari (environment variables) — NAMUNA
#
# !!! DIQQAT — JUDA MUHIM !!!
# Bu fayl GitHub'ga yuklanadi va HAMMAGA ko'rinadi.
# SHU FAYLGA HAQIQIY KALIT/TOKEN/PAROL YOZMA!
# Bu yerda faqat BO'SH namuna turadi.
#
# Haqiqiy maxfiy qiymatlarni FAQAT Vercel -> Settings ->
# Environment Variables bo'limiga kiritasan. Boshqa hech qayerga.
# ====================================================================

# --- Telegram ---
# @BotFather'dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=

# Botning username'i (faqat nom, masalan: SkillsB_bot) — "@" yoki "https:" YOZMA
TELEGRAM_BOT_USERNAME=

# --- Supabase (ma'lumotlar bazasi) ---
# Supabase loyiha sozlamalaridan: Project URL (https:// bilan)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase secret (service_role) kaliti — MAXFIY, faqat Vercel'ga
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (AI matching uchun, ixtiyoriy) ---
# Bo'sh qoldirsang, app baribir ishlaydi (oddiy matching bilan).
OPENAI_API_KEY=

# --- App ---
# Deploy qilingandan keyingi to'liq manzil (https:// bilan, masalan: https://skills.vercel.app)
NEXT_PUBLIC_APP_URL=
