# ====================================================================
# SkillSwap muhit o'zgaruvchilari (environment variables)
# Bu faylni nusxalab ".env.local" deb nomla va qiymatlarni to'ldir.
# DIQQAT: bu qiymatlar MAXFIY. Hech qachon GitHub'ga yuklama.
# ====================================================================

# --- Telegram ---
# @BotFather'dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=

# Botning username'i (masalan: skillswap_bot) — @ belgisisiz
TELEGRAM_BOT_USERNAME=8844945576:AAH_hNLpIr5G0LQEmhkna-BiRu8uozcUoxg

# --- Supabase (ma'lumotlar bazasi) ---
# Supabase loyiha sozlamalaridan: Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "service_role" kaliti (faqat serverda ishlatiladi, MAXFIY)
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (AI matching uchun, ixtiyoriy) ---
# Bo'sh qoldirsang, app baribir ishlaydi (oddiy matching bilan).
# Kalit qo'shsang — AI aqlli tavsiya va tanishuv xabarini yaratadi.
OPENAI_API_KEY=

# --- App ---
# Deploy qilingandan keyingi to'liq manzil (masalan: https://skillswap.vercel.app)
NEXT_PUBLIC_APP_URL=
